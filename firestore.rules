rules_version = '2';

// IA STORE — Firestore Security Rules
//
// • Customers (not signed in) can: read visible products, create an order.
// • Only the store owner can: read/change orders, create/edit/delete products.
// • The owner is whoever has a document in the "admins" collection whose ID is their
//   Firebase Auth UID. That document can only be created manually in the Firebase Console.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allow-list (read only your own entry, never writable from the app)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Products
    match /products/{productId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['orderNumber', 'customer', 'items', 'total', 'status', 'stockDeducted', 'createdAt'])
        && request.resource.data.status == 'Pending'
        && request.resource.data.stockDeducted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() <= 30
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() >= 2
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 6
        && request.resource.data.customer.phone.size() <= 25
        && request.resource.data.customer.wilaya is string
        && request.resource.data.customer.wilaya.size() <= 120
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() <= 300
        && request.resource.data.customer.notes is string
        && request.resource.data.customer.notes.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40
        && request.resource.data.total is number
        && request.resource.data.total > 0;

      allow read, update, delete: if isAdmin();
    }
  }
}