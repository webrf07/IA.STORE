rules_version = '2';

// IA STORE — Firebase Storage Security Rules
// Product photos are public to read; only the store owner (listed in the Firestore
// "admins" collection) can upload or delete them. Images only, max 6 MB each.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}